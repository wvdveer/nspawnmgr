# Environment-variable form of the same settings, for running the prod-profile jar directly.
COOKIE_NAME=nspawnmgr_session
USER_ID_URL=http://localhost:8080/auth/userinfo
USER_ID_JSON=$.id
USER_USERNAME_JSON=$.username
USER_EMAIL_JSON=$.email
USER_FULLNAME_JSON=$.fullName

TEMPLATES_DIR=/var/lib/nspawnmgr/templates
NSPAWN_MACHINES_DIR=/var/lib/machines
NSPAWN_SETTINGS_DIR=/etc/systemd/nspawn

HOST_PUBLIC_ADDRESS=127.0.0.1
# The outward-facing hostname/DNS name users OUTSIDE this host use — different from
# HOST_PUBLIC_ADDRESS above (that one's for guacd reaching into containers). See
# docs/administrator-guide.md §8. Seeded to this machine's real hostname by setup-sudo-account.sh
# on .deb installs; the value below is only a placeholder for manual installs.
HOST_EXTERNAL_HOSTNAME=localhost

GUACAMOLE_BASE_URL=http://localhost:8080/guacamole
GUACAMOLE_ADMIN_USERNAME=guacadmin
GUACAMOLE_ADMIN_PASSWORD=guacadmin
GUACAMOLE_DATA_SOURCE=mysql
# GUACAMOLE_HOME=/etc/guacamole                                          # default shown; uncomment to override
# AUTH_SETTINGS_FILE=/etc/nspawnmgr/auth-live/auth-settings.properties   # default shown; uncomment to override

# Generate with: openssl rand -base64 32
APP_SECRET_KEY=

DB_URL=jdbc:mysql://localhost:3306/nspawnmgr
DB_USERNAME=nspawnmgr
DB_PASSWORD=

CONTAINER_CLI_EXECUTOR=real
SPRING_PROFILES_ACTIVE=prod
