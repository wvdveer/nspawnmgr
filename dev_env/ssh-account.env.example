# Copy to dev_env/ssh-account.env (gitignored). Credentials for the separate local sudo-capable
# account that RealContainerCliExecutor/RealContainerFilesystemProvisioner SSH into (see
# nspawnmgr.ssh.* in application.yml and src/main/java/com/nspawnmgr/cli/real/SshRemoteExecutor.java)
# since nspawnmgr itself runs as a non-privileged user with no sudo.
#
# Also sourced directly by tools/scripts/setup-container-template.sh and
# tools/scripts/real-lifecycle-test.sh (via tools/scripts/lib/ssh-sudo.sh) for the
# real-container-lifecycle CI job, and passed straight through as -D system properties when
# starting nspawnmgr for that job (see tools/scripts/start-real-stack.sh) — the variable names
# below match what application.yml already reads (SSH_HOST/SSH_PORT/SSH_USERNAME/SSH_PASSWORD).
#
# Needs `sshpass` installed on the runner (apt install sshpass): plain, non-interactive
# password-based SSH from a shell script needs a helper like this. The app itself doesn't need
# it — SshRemoteExecutor authenticates over the SSH protocol directly, no external tool involved.
SSH_HOST=127.0.0.1
SSH_PORT=22
SSH_USERNAME=nspawn-admin
SSH_PASSWORD=change-me

# Optional override — start-real-stack.sh auto-detects this host's real address (via `ip route
# get`/`hostname -I`) and passes it through as -DHOST_PUBLIC_ADDRESS, so this normally doesn't need
# to be set. Only needed if auto-detection picks the wrong interface (multi-homed host) or you
# deliberately want something else. See start-real-stack.sh's own comment for why a literal
# 127.0.0.1 doesn't work on every host: some NAT setups (seen with systemd-networkd's own
# io.systemd.nat table) refuse to hairpin loopback-destined traffic back into a container even
# though the forward itself is configured correctly.
#HOST_PUBLIC_ADDRESS=192.168.1.15
