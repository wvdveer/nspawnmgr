# Copy to dev_env/ci-test-user.env (gitignored) on the CI runner. Sourced by the "integration-test"
# job in .gitea/workflows/ci.yml to log into auth/'s PAM-based login (LinuxPamOsAuthenticator)
# as a real OS account — the runner has no root, so CI can't create/manage this account itself.
#
# The account just needs to exist and be able to log in; it isn't given any special privileges.
CI_TEST_USERNAME=ciuser
CI_TEST_PASSWORD=change-me
