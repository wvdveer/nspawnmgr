<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>nspawnmgr-auth</display-name>

    <!-- Override the cookie name to match nspawnmgr's COOKIE_NAME setting; defaults to nspawnmgr_session. -->
    <context-param>
        <param-name>cookie.name</param-name>
        <param-value>nspawnmgr_session</param-value>
    </context-param>

    <!--
        Blank here (not hardcoded to "pam"): AuthConfig.setting() only falls back to the
        AUTH_BACKEND/SMB_SERVER/etc. system properties when the context-param is null OR blank - a
        non-blank value here would always win over the system property regardless, which
        contradicts the whole point of "configurable via env vars without editing this file".
        "pam" (local Linux accounts on this host) is still the effective default via AuthConfig's
        own Java-level default when neither this nor the system property is set. "smb" authenticates
        against a remote Windows machine/domain instead — set smb.server (and optionally smb.domain)
        below, or via the SMB_SERVER/SMB_DOMAIN system properties.
    -->
    <context-param>
        <param-name>auth.backend</param-name>
        <param-value></param-value>
    </context-param>
    <context-param>
        <param-name>smb.server</param-name>
        <param-value></param-value>
    </context-param>
    <context-param>
        <param-name>smb.domain</param-name>
        <param-value></param-value>
    </context-param>
    <!-- Optional, auth.backend=pam only: a Unix group users must belong to in order to log in.
         Blank means no gate. Also settable via AUTH_REQUIRED_GROUP. -->
    <context-param>
        <param-name>auth.required-group</param-name>
        <param-value></param-value>
    </context-param>
    <!-- Optional, auth.backend=smb only: a share on smb.server users must have access to (via
         ordinary share/NTFS permissions) in order to log in. Blank means no gate. A share-access
         check rather than a group-membership query deliberately: Windows restricts remote group
         queries to Administrators by default, whereas share access is just a normal, ACL-gated SMB
         operation any authenticated user can be granted. Also settable via SMB_REQUIRED_SHARE. -->
    <context-param>
        <param-name>smb.required-share</param-name>
        <param-value></param-value>
    </context-param>
    <!-- Path to the shared properties file nspawnmgr's /admin/settings page writes to on every
         save (see SettingsService.writeAuthSettingsFile()) — checked first, ahead of every
         context-param above, on every request. Blank here defaults to
         /etc/nspawnmgr/auth-live/auth-settings.properties (AuthConfig.DEFAULT_SETTINGS_FILE); a
         missing file is not an error, it just means "no live override yet". Also settable via
         AUTH_SETTINGS_FILE. -->
    <context-param>
        <param-name>auth.settings-file</param-name>
        <param-value></param-value>
    </context-param>

    <servlet>
        <servlet-name>login</servlet-name>
        <servlet-class>com.nspawnmgr.osauth.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>login</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>userinfo</servlet-name>
        <servlet-class>com.nspawnmgr.osauth.UserInfoServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>userinfo</servlet-name>
        <url-pattern>/userinfo</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>logout</servlet-name>
        <servlet-class>com.nspawnmgr.osauth.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>logout</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <!-- Machine-to-machine counterpart to /login, called only by nspawnmgr.war's own
         PamAuthVerifyController over loopback - see VerifyServlet's own javadoc. -->
    <servlet>
        <servlet-name>verify</servlet-name>
        <servlet-class>com.nspawnmgr.osauth.VerifyServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>verify</servlet-name>
        <url-pattern>/verify</url-pattern>
    </servlet-mapping>

</web-app>
