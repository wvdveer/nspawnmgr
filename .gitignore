# ---> nspawnmgr local dev
site/env/application-local.yml
site/env/.env
*.log
# Downloaded distributables (e.g. Apache Tomcat), cached so setup-tomcat.sh doesn't re-fetch.
/tools/downloads/
# Extracted, working Tomcat instance used for real side-by-side integration testing with
# Guacamole's own WAR — regenerated by tools/scripts/setup-tomcat.sh, never committed.
/site/tomcat/
# nspawnmgr.war exploded outside webapps/ by start-dev-stack.sh, with fake-machinectl injected —
# regenerated on every dev-stack run, never committed.
/site/tomcat-apps/
# Fake-mode QEMU template artifacts (FakeContainerFilesystemProvisioner's stub .qcow2 files),
# written here by local template-pack testing — the directory itself stays tracked (see
# site/templates/qemu/.gitkeep, matching dev_env/certs/.gitkeep's own convention) so
# TEMPLATES_DIR's real, production per-backend layout exists on a fresh checkout, but nothing
# generated inside it should be.
/site/templates/qemu/*
!/site/templates/qemu/.gitkeep

# ---> nspawnmgr packaging vendor artifacts
# Baked, multi-hundred-MB pre-built rootfs tarballs used by the "bundled" .deb variant plus the
# Arch/SteamOS/RPM packages - see packaging/nspawnmgr-deb/vendor/README.md. Too large to keep in
# Git history; tools/scripts/ensure-vendor-templates.sh downloads them from Gitea's package
# registry (or bakes+publishes them itself if missing) as part of a package build, so they're
# still built and included in published packages, just not tracked here.
/packaging/nspawnmgr-deb/vendor/debian-minimal.tar.gz
/packaging/nspawnmgr-deb/vendor/postgresql-minimal.tar.gz

# ---> Maven
target/
tools/*/target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
# https://github.com/takari/maven-wrapper#usage-without-binary-jar
.mvn/wrapper/maven-wrapper.jar

# Eclipse m2e generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath

/.idea/
/.claude/
/CLAUDE.md
