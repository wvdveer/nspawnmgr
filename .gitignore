# Downloaded distributables (e.g. Apache Tomcat), cached so setup-tomcat.sh doesn't re-fetch.
/tools/downloads/
# Extracted, working Tomcat instance used for real side-by-side integration testing with
# Guacamole's own WAR — regenerated by tools/scripts/setup-tomcat.sh, never committed.
/site/tomcat/
# nspawnmgr.war exploded outside webapps/ by start-dev-stack.sh, with fake-machinectl injected —
# regenerated on every dev-stack run, never committed.
/site/tomcat-apps/

