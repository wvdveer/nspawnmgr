#!/bin/sh
# See docs/administrator-guide.md for the full rationale behind every step below. The
# account/sudoers/keypair setup lives in the shared setup-sudo-account.sh (shipped at
# /usr/lib/nspawnmgr/setup-sudo-account.sh), which is also runnable standalone outside a .deb
# install — see that script's own header comment. Tomcat/guacd/the four bundled WARs are no longer
# deployed on this host at all — nspawnmgr runs from its own self-hosted machine instead (see
# nspawnmgr-bootstrap-app-machine.sh); this host only ever runs the sudo-capable SSH account,
# templates/packages storage, the shared bridge, and dnsmasq.
set -e

case "$1" in
    configure) ;;
    *) exit 0 ;;
esac

if [ "$(id -u)" -ne 0 ]; then
    echo "nspawnmgr: postinst must be run as root (via dpkg/apt)." >&2
    exit 1
fi

# 1-6. Service account, stored password, SSH keypair, sudoers, sshd carve-out. dpkg has already
#      unpacked the wrapper scripts (/usr/lib/nspawnmgr/privileged/) and the sudoers file
#      (/etc/sudoers.d/nspawnmgr_exec) by this point, so this runs in "validate what's already
#      there" mode rather than copying from a repo checkout.
/usr/lib/nspawnmgr/setup-sudo-account.sh

# 7. Shared bridge (nspawnbr0) every managed container's veth gets enslaved into at start (see
#    NspawnSettingsRenderer's Bridge= setting) instead of each getting its own isolated
#    point-to-point veth — including the self-hosted nspawnmgr/database machines themselves, which
#    is why this must be in place before nspawnmgr-bootstrap-app-machine.sh runs below. Always
#    overwritten - fixed convention, holds no admin customization, same treatment as the dnsmasq
#    config below.
cp /usr/share/nspawnmgr/70-nspawnmgr-bridge.netdev /etc/systemd/network/70-nspawnmgr-bridge.netdev
cp /usr/share/nspawnmgr/70-nspawnmgr-bridge.network /etc/systemd/network/70-nspawnmgr-bridge.network
# enable, not just restart - confirmed live (real Fedora 43 host, packaging/nspawnmgr-rpm/
# verification): a plain restart only affects the current boot, so systemd-networkd (and with it
# nspawnbr0/every container's own networking) never came back after a real host reboot until an
# admin ran `systemctl enable --now systemd-networkd` by hand - exactly the command
# debian/nspawnmgr.sudoers already grants nspawnmgr_exec for a diagnostics-page repair, which
# should never have been necessary for a fresh, un-tampered-with install in the first place.
systemctl enable --now systemd-networkd \
    || echo "nspawnmgr: systemd-networkd enable/start failed — check 'systemctl status systemd-networkd'." >&2
# `enable --now` on a systemd-networkd that's already running (e.g. any reinstall) is a no-op for
# the "now" part — it does NOT notice the 70-nspawnmgr-bridge.netdev/.network files just copied
# above, so nspawnbr0 silently never gets created. `networkctl reload` forces networkd to re-read
# every .netdev/.network file without restarting the daemon or disrupting any link it's already
# managing — safe to call unconditionally here regardless of whether the enable/start above was a
# fresh start or a no-op against an already-running daemon. Confirmed live (SteamOS, same
# underlying systemd-networkd mechanism): without this, a fresh install on a host where networkd
# was already active left nspawnbr0 never created at all.
networkctl reload \
    || echo "nspawnmgr: networkctl reload failed — nspawnbr0 may not pick up its config; check 'systemctl status systemd-networkd'." >&2

# systemctl restart returns once the restart is *issued*, not once systemd-networkd has actually
# finished bringing nspawnbr0 up with its address - confirmed live, dnsmasq's own restart just
# below (now a plain interface=nspawnbr0 bind, no more bind-dynamic to tolerate the interface not
# existing yet - see dnsmasq-nspawnmgr.conf) can lose this race and fail outright if it starts
# before the bridge is really ready. Poll for up to 10s rather than proceeding immediately.
bridge_ready=0
i=1
while [ "$i" -le 20 ]; do
    if /usr/sbin/ip -4 -o addr show nspawnbr0 2>/dev/null | grep -q '10\.100\.0\.1/24'; then
        bridge_ready=1
        break
    fi
    sleep 0.5
    i=$((i + 1))
done
[ "$bridge_ready" -eq 1 ] \
    || echo "nspawnmgr: nspawnbr0 didn't come up with 10.100.0.1/24 within 10s — the self-hosted machine bootstrap below may fail; check 'systemctl status systemd-networkd'." >&2

# v0.1.0's per-veth model never ran a host-side DHCP server at all, so a host firewall never needed
# a rule for it - the switch to one shared bridge with DHCPServer=yes above (see
# 70-nspawnmgr-bridge.network) introduced a real host-local DHCP server process that a default-deny
# ufw setup silently drops DHCPDISCOVER packets before they ever reach, confirmed live (acer,
# 2026-08-22): containers timed out waiting for a lease and self-assigned a 169.254.x.x link-local
# address instead, stuck in BOOTING forever. Only touches ufw if it's actually installed and active -
# same tolerance as NetworkDiagnosticsService's own checkUfw(), since running ufw at all is the
# admin's own choice, not something this package requires.
if command -v ufw >/dev/null 2>&1 && ufw status | grep -q '^Status: active'; then
    ufw allow in on nspawnbr0 to any port 67 proto udp \
        || echo "nspawnmgr: failed to add a ufw rule allowing DHCP on nspawnbr0 - containers may never get an address; check 'sudo ufw status verbose'." >&2
fi

# 8. dnsmasq — a real apt dependency (unlike the self-hosted machines' own software below),
#    configured to let managed containers (the self-hosted nspawnmgr/database machines included)
#    resolve each other by name. /etc/nspawnmgr/dns-hosts and /etc/dnsmasq.d/nspawnmgr-upstream.conf
#    are only touched/seeded if missing (like the guacamole.properties seed used to be) -
#    ContainerDnsSyncService overwrites both on every sync tick regardless once nspawnmgr itself is
#    up (the latter with whatever's configured on /admin/settings, defaulting to 1.1.1.1/9.9.9.9),
#    so there's no admin customization here to protect - just "give dnsmasq a sane default before
#    nspawnmgr's own first sync tick, rather than no upstream resolution at all in that window". The
#    main config file itself IS always overwritten - it holds no admin customization, only this
#    package's own fixed addn-hosts/interface scoping.
cp /usr/share/nspawnmgr/dnsmasq-nspawnmgr.conf /etc/dnsmasq.d/nspawnmgr.conf
mkdir -p /etc/nspawnmgr
[ -f /etc/nspawnmgr/dns-hosts ] || touch /etc/nspawnmgr/dns-hosts
[ -f /etc/dnsmasq.d/nspawnmgr-upstream.conf ] || printf 'server=1.1.1.1\nserver=9.9.9.9\n' > /etc/dnsmasq.d/nspawnmgr-upstream.conf
systemctl restart dnsmasq \
    || echo "nspawnmgr: dnsmasq restart failed — check 'systemctl status dnsmasq'." >&2

# 9. nspawnmgr runs from one of its own machines: bakes debian-minimal if it doesn't exist yet,
#    clones it, and installs a JRE/Tomcat/the four bundled WARs/guacd into it directly (this host
#    never runs any of that itself) — see that script's own header comment for the full sequence,
#    including the free-host-port search for the inbound :8080 forward and the SSH-back credential
#    setup that lets the app reach back out to this host's own nspawnmgr_exec account once it
#    boots.
/usr/lib/nspawnmgr/privileged/nspawnmgr-bootstrap-app-machine.sh

exit 0
