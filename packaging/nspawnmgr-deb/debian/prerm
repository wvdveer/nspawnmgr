#!/bin/sh
# Stops guacd and tomcat9 before this package's files are removed. Deliberately does NOT touch
# nspawnmgr_exec/anything under /opt/tomcat9 itself — see postrm for the same "don't touch it"
# rule applied to the sudo account and Tomcat's own data/config, for different reasons.
set -e

case "$1" in
    remove | upgrade | deconfigure) ;;
    *) exit 0 ;;
esac

systemctl stop guacd 2>/dev/null || true
systemctl disable guacd 2>/dev/null || true

systemctl stop tomcat9 2>/dev/null || true
systemctl disable tomcat9 2>/dev/null || true

exit 0
