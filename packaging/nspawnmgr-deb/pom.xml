<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        No <parent>: same reasoning as tools/fake-machinectl's pom — this module just packages
        already-built WARs into a .deb, so it doesn't need the Spring Boot parent at all. Build
        this LAST, after `mvn install` (root), `mvn -f auth/pom.xml package`, and
        `mvn -f root-wizard/pom.xml package` have produced target/nspawnmgr.war,
        auth/target/auth.war, and root-wizard/target/ROOT.war — see tools/scripts/build-all.sh.
    -->
    <groupId>com.nspawnmgr</groupId>
    <artifactId>nspawnmgr-deb</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>nspawnmgr-deb</name>
    <description>Debian package for production nspawnmgr deployment</description>

    <properties>
        <jdeb.version>1.10</jdeb.version>
        <!-- Must match debian/control's Package/Version exactly. jdeb's default output filename
             uses this MODULE's own Maven artifactId/version ("nspawnmgr-deb"/"0.1.0-SNAPSHOT"),
             not the control file's actual package identity — without this override, a local
             build produces a confusingly-misnamed nspawnmgr-deb_0.1.0~SNAPSHOT_all.deb instead
             of the real installable package name. Bump both together when releasing a version. -->
        <deb.output>${project.build.directory}/nspawnmgr_0.1.0_all.deb</deb.output>
        <nspawnmgr.war>${project.basedir}/../../target/nspawnmgr.war</nspawnmgr.war>
        <auth.war>${project.basedir}/../../auth/target/auth.war</auth.war>
        <root.war>${project.basedir}/../../root-wizard/target/ROOT.war</root.war>
        <!-- Produced by root pom.xml's stage-guacamole-jdbc-drivers execution — see the long
             comment on its mysql-connector-j/postgresql <dependency> entries. -->
        <guacamole.jdbc.drivers.dir>${project.basedir}/../../target/guacamole-jdbc-drivers</guacamole.jdbc.drivers.dir>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.vafer</groupId>
                <artifactId>jdeb</artifactId>
                <version>${jdeb.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>jdeb</goal>
                        </goals>
                        <configuration>
                            <controlDir>${project.basedir}/debian</controlDir>
                            <deb>${deb.output}</deb>
                            <verbose>true</verbose>
                            <!-- jdeb defaults to skipping pom-packaged projects, but that's this
                                 module's whole packaging type (it produces no jar/war of its own,
                                 just packages already-built WARs) — must override explicitly. -->
                            <skipPOMs>false</skipPOMs>
                            <dataSet>
                                <data>
                                    <src>${nspawnmgr.war}</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/share/nspawnmgr</prefix>
                                        <filemode>644</filemode>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${auth.war}</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/share/nspawnmgr</prefix>
                                        <filemode>644</filemode>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.basedir}/vendor/guacamole-1.5.5.war</src>
                                    <type>file</type>
                                    <dst>guacamole.war</dst>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/share/nspawnmgr</prefix>
                                        <filemode>644</filemode>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.basedir}/privileged-scripts</src>
                                    <type>directory</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/lib/nspawnmgr/privileged</prefix>
                                        <filemode>750</filemode>
                                        <user>root</user>
                                        <group>root</group>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.basedir}/debian/nspawnmgr.sudoers</src>
                                    <type>file</type>
                                    <dst>nspawnmgr_exec</dst>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/etc/sudoers.d</prefix>
                                        <filemode>440</filemode>
                                        <user>root</user>
                                        <group>root</group>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.basedir}/scripts/setup-sudo-account.sh</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/lib/nspawnmgr</prefix>
                                        <filemode>750</filemode>
                                        <user>root</user>
                                        <group>root</group>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.basedir}/scripts/install-guacamole-auth-jdbc.sh</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/lib/nspawnmgr</prefix>
                                        <filemode>750</filemode>
                                        <user>root</user>
                                        <group>root</group>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.basedir}/scripts/install-guacamole-jdbc-drivers.sh</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/lib/nspawnmgr</prefix>
                                        <filemode>750</filemode>
                                        <user>root</user>
                                        <group>root</group>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.basedir}/scripts/uninstall-nspawnmgr.sh</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/lib/nspawnmgr</prefix>
                                        <filemode>750</filemode>
                                        <user>root</user>
                                        <group>root</group>
                                    </mapper>
                                </data>
                                <!-- Opt-in CI/CD template-install account (nspawnmgr_ci) - staged only, never
                                     activated by installing the package. See
                                     scripts/setup-ci-template-account.sh's own header comment. -->
                                <data>
                                    <src>${project.basedir}/scripts/setup-ci-template-account.sh</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/lib/nspawnmgr</prefix>
                                        <filemode>750</filemode>
                                        <user>root</user>
                                        <group>root</group>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.basedir}/debian/nspawnmgr-ci.sudoers</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/share/nspawnmgr</prefix>
                                        <filemode>644</filemode>
                                        <user>root</user>
                                        <group>root</group>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${guacamole.jdbc.drivers.dir}</src>
                                    <type>directory</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/share/nspawnmgr/guacamole-jdbc-drivers</prefix>
                                        <filemode>644</filemode>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.basedir}/vendor/guacd-bundle.tar.gz</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/share/nspawnmgr</prefix>
                                        <filemode>644</filemode>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.basedir}/vendor/guacamole-auth-jdbc-1.5.5.tar.gz</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/share/nspawnmgr</prefix>
                                        <filemode>644</filemode>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.basedir}/guacd.service</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/share/nspawnmgr</prefix>
                                        <filemode>644</filemode>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.basedir}/vendor/README.md</src>
                                    <type>file</type>
                                    <dst>guacd-bundle-README.md</dst>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/share/doc/nspawnmgr</prefix>
                                        <filemode>644</filemode>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.basedir}/vendor/apache-tomcat-9.0.120.tar.gz</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/share/nspawnmgr</prefix>
                                        <filemode>644</filemode>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.basedir}/tomcat9.service</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/share/nspawnmgr</prefix>
                                        <filemode>644</filemode>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.basedir}/dnsmasq-nspawnmgr.conf</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/share/nspawnmgr</prefix>
                                        <filemode>644</filemode>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.basedir}/70-nspawnmgr-bridge.netdev</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/share/nspawnmgr</prefix>
                                        <filemode>644</filemode>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.basedir}/70-nspawnmgr-bridge.network</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/share/nspawnmgr</prefix>
                                        <filemode>644</filemode>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${root.war}</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/share/nspawnmgr</prefix>
                                        <filemode>644</filemode>
                                    </mapper>
                                </data>
                                <data>
                                    <src>${project.basedir}/../../docs/administrator-guide.md</src>
                                    <type>file</type>
                                    <mapper>
                                        <type>perm</type>
                                        <prefix>/usr/share/doc/nspawnmgr</prefix>
                                        <filemode>644</filemode>
                                    </mapper>
                                </data>
                            </dataSet>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
