# Maintainer: nspawnmgr packaging <packaging@nspawnmgr.invalid>
#
# Arch package for production nspawnmgr deployment - the Arch-host equivalent of
# ../nspawnmgr-deb (a .deb). No Maven-native Arch packaging plugin exists (unlike jdeb for
# .deb or rpm-maven-plugin for .rpm), so this is a plain PKGBUILD driven directly by
# tools/scripts/build-all.sh's own BUILD_ARCH_PKG=1 opt-in step, not a Maven module.
#
# Like the .deb, this package ships already-built artifacts (the WARs, the vendored
# guacd/Tomcat/Guacamole binaries) rather than building anything from a downloaded source
# tarball - there's nothing for source=()/sha256sums() to track, so both stay empty and
# package() reads everything it needs directly out of the sibling ../nspawnmgr-deb/ and
# ../../ (repo root) trees via $startdir, the same "reference already-built artifacts by
# relative path" approach ../nspawnmgr-deb/pom.xml's jdeb <data> entries already use. Build
# root/auth/root-wizard first (`mvn ... install/package`, see tools/scripts/build-all.sh) -
# this package's own build() step deliberately does nothing, matching that convention.
#
# Deliberately reuses ../nspawnmgr-deb/'s privileged-scripts/, vendor/ binaries, and sudoers
# files by reference rather than duplicating them - all three are already confirmed portable
# across Debian/Fedora/Arch (see docs/administrator-guide.md's Arch install section for the
# one exception: nspawnmgr.sudoers carries one Debian-only NOPASSWD grant for `ufw status
# verbose`, harmlessly inert here since Arch has no ufw by default - not worth forking the
# file over one dead line).
#
# BUILD verified live (2026-08-26): a real `makepkg -f` against this exact file, on a real Arch
# rootfs (a systemd-nspawn container on acer registered as a Gitea Actions runner labeled
# `arch:host` - see packaging/ci/arch-runner/), produces a real nspawnmgr-0.3.0-1-any.pkg.tar.zst
# via .gitea/workflows/build.yml's `arch-package` job. Two real bugs this surfaced and fixed
# elsewhere: Spring Boot 2.7's pinned Lombok doesn't support JDK 26 (Arch's official jdk-openjdk
# always tracks latest - the CI job now downloads a pinned Temurin JDK 21 instead, see that job's
# own comments) and makepkg checks depends() are actually present on the build machine even
# though build() here is a no-op (openssh/dnsmasq now installed alongside the JDK for that
# reason).
#
# INSTALL still unverified: `pacman -U` actually installing this package and nspawnmgr.install's
# hooks running for real on a live Arch system has not been exercised - only the build side is
# proven so far. Report back what breaks.

pkgname=nspawnmgr
pkgver=0.4.0
pkgrel=1
pkgdesc="Web manager for systemd-nspawn containers, podman pods, and QEMU/KVM virtual machines with Guacamole access"
arch=('any')
# TODO: fill in once a public repo URL exists.
url=""
license=('Apache')
# This package builds nothing of its own (see build() below) - only bundles prebuilt binaries
# (guacd, Tomcat, Guacamole) and shell/data files. makepkg's default debug-package generation
# needs `debugedit`, which isn't installed on a stock system and is irrelevant here regardless -
# there's no compiled output for it to extract debug symbols from.
options=('!debug')
# No systemd-container equivalent needed at all - machinectl/systemd-nspawn ship in Arch's own
# base systemd package already. No JRE/rotatelogs-equivalent needed on the bare host either -
# both were a stale leftover from before nspawnmgr became self-hosted (fixed in
# ../nspawnmgr-deb/debian/control at the same time this package was written): Tomcat now runs
# entirely inside the self-hosted "nspawnmgr" machine nspawnmgr-bootstrap-app-machine.sh creates,
# which installs its own JRE + apache2-utils-equivalent from scratch inside that machine's own
# rootfs - nothing this package's own Depends: needs to provide on the bare host.
depends=('openssh' 'openssl' 'dnsmasq')
backup=('etc/dnsmasq.d/nspawnmgr.conf')
install=nspawnmgr.install
source=()
sha256sums=()

# Nothing to build - every artifact this package ships is either already-built (the WARs, via
# a separate `mvn` invocation run before this PKGBUILD, same as ../nspawnmgr-deb's own pom.xml
# expects) or a vendored binary (guacd/Tomcat/Guacamole, under ../nspawnmgr-deb/vendor/).
build() {
    :
}

package() {
    debdir="$startdir/../nspawnmgr-deb"
    reporoot="$startdir/../.."

    # WARs - built by `mvn` ahead of time, same three artifacts ../nspawnmgr-deb/pom.xml
    # depends on (see that file's own comment for the exact build order).
    install -Dm644 "$reporoot/target/nspawnmgr.war" "$pkgdir/usr/share/nspawnmgr/nspawnmgr.war"
    install -Dm644 "$reporoot/auth/target/auth.war" "$pkgdir/usr/share/nspawnmgr/auth.war"
    install -Dm644 "$reporoot/root-wizard/target/ROOT.war" "$pkgdir/usr/share/nspawnmgr/ROOT.war"
    install -Dm644 "$debdir/vendor/guacamole-1.5.5.war" "$pkgdir/usr/share/nspawnmgr/guacamole.war"

    # Privileged scripts - shared verbatim with the .deb, already distro-agnostic.
    install -d -m755 "$pkgdir/usr/lib/nspawnmgr/privileged"
    for f in "$debdir/privileged-scripts"/*.sh; do
        install -Dm750 -o root -g root "$f" "$pkgdir/usr/lib/nspawnmgr/privileged/$(basename "$f")"
    done

    # Shared setup/uninstall scripts - see setup-sudo-account.sh's own comment on why these are
    # useradd/userdel-based (portable), not adduser/deluser (Debian-only).
    install -Dm750 -o root -g root "$debdir/scripts/setup-sudo-account.sh" "$pkgdir/usr/lib/nspawnmgr/setup-sudo-account.sh"
    install -Dm750 -o root -g root "$debdir/scripts/setup-ci-template-account.sh" "$pkgdir/usr/lib/nspawnmgr/setup-ci-template-account.sh"
    install -Dm750 -o root -g root "$debdir/scripts/uninstall-nspawnmgr.sh" "$pkgdir/usr/lib/nspawnmgr/uninstall-nspawnmgr.sh"
    install -Dm750 -o root -g root "$debdir/scripts/upgrade-nspawnmgr.sh" "$pkgdir/usr/lib/nspawnmgr/upgrade-nspawnmgr.sh"
    install -Dm750 -o root -g root "$debdir/scripts/install-guacamole-auth-jdbc.sh" "$pkgdir/usr/lib/nspawnmgr/install-guacamole-auth-jdbc.sh"
    install -Dm750 -o root -g root "$debdir/scripts/install-guacamole-jdbc-drivers.sh" "$pkgdir/usr/lib/nspawnmgr/install-guacamole-jdbc-drivers.sh"

    # Sudoers - nspawnmgr_exec activated immediately (mode 440, root:root, as sudo itself
    # requires); nspawnmgr_ci staged only under /usr/share, same as the .deb - never activated
    # by installing this package, only by running setup-ci-template-account.sh by hand.
    install -Dm440 -o root -g root "$debdir/debian/nspawnmgr.sudoers" "$pkgdir/etc/sudoers.d/nspawnmgr_exec"
    install -Dm644 -o root -g root "$debdir/debian/nspawnmgr-ci.sudoers" "$pkgdir/usr/share/nspawnmgr/nspawnmgr-ci.sudoers"

    # Bridge / dnsmasq / systemd unit templates - copied into place at install time by
    # nspawnmgr.install's post_install(), staged here under /usr/share the same way the .deb
    # stages them under the same path before postinst copies them into /etc.
    install -Dm644 "$debdir/70-nspawnmgr-bridge.netdev" "$pkgdir/usr/share/nspawnmgr/70-nspawnmgr-bridge.netdev"
    install -Dm644 "$debdir/70-nspawnmgr-bridge.network" "$pkgdir/usr/share/nspawnmgr/70-nspawnmgr-bridge.network"
    install -Dm644 "$debdir/dnsmasq-nspawnmgr.conf" "$pkgdir/usr/share/nspawnmgr/dnsmasq-nspawnmgr.conf"
    install -Dm644 "$debdir/guacd.service" "$pkgdir/usr/share/nspawnmgr/guacd.service"
    install -Dm644 "$debdir/tomcat9.service" "$pkgdir/usr/share/nspawnmgr/tomcat9.service"

    # Vendored binaries - guacd bundle, Tomcat, Guacamole's auth-jdbc extension. Reused verbatim;
    # already confirmed to need nothing beyond baseline glibc (see docs/administrator-guide.md).
    install -Dm644 "$debdir/vendor/guacd-bundle.tar.gz" "$pkgdir/usr/share/nspawnmgr/guacd-bundle.tar.gz"
    install -Dm644 "$debdir/vendor/guacamole-auth-jdbc-1.5.5.tar.gz" "$pkgdir/usr/share/nspawnmgr/guacamole-auth-jdbc-1.5.5.tar.gz"

    # Pre-baked debian-minimal/postgresql-minimal images - same two files
    # ../nspawnmgr-deb-bundled/pom.xml stages for the *published* .deb (publish-deb explicitly
    # publishes the bundled variant, not ../nspawnmgr-deb's own "online" one - see that job's own
    # comment in .gitea/workflows/build.yml). Consistency: whatever ships in the published .deb
    # should ship here too, not a smaller/network-dependent install by default. Landing at this
    # exact path is what makes it work with zero script changes -
    # nspawnmgr-bootstrap-app-machine.sh/nspawnmgr-bootstrap-db-machine.sh already check for
    # BUNDLED_DEBIAN_MINIMAL/BUNDLED_POSTGRESQL_MINIMAL at these same /usr/share/nspawnmgr/ paths
    # and prefer a plain copy over baking/downloading fresh when present - that fallback was
    # written once, shared verbatim by every package that reuses these scripts by reference.
    install -Dm644 "$debdir/vendor/debian-minimal.tar.gz" "$pkgdir/usr/share/nspawnmgr/debian-minimal.tar.gz"
    install -Dm644 "$debdir/vendor/postgresql-minimal.tar.gz" "$pkgdir/usr/share/nspawnmgr/postgresql-minimal.tar.gz"
    install -Dm644 "$debdir/vendor/apache-tomcat-9.0.120.tar.gz" "$pkgdir/usr/share/nspawnmgr/apache-tomcat-9.0.120.tar.gz"

    # JDBC drivers - produced by the root pom.xml's stage-guacamole-jdbc-drivers execution,
    # same as ../nspawnmgr-deb/pom.xml expects.
    install -d -m755 "$pkgdir/usr/share/nspawnmgr/guacamole-jdbc-drivers"
    for f in "$reporoot/target/guacamole-jdbc-drivers"/*; do
        install -Dm644 "$f" "$pkgdir/usr/share/nspawnmgr/guacamole-jdbc-drivers/$(basename "$f")"
    done

    # TranslationService's own source files - same "host-side fixed path, copied into the
    # machine's rootfs at bootstrap" pattern as everything else above, see
    # nspawnmgr-bootstrap-app-machine.sh's own lang/ dir step.
    install -d -m755 "$pkgdir/usr/share/nspawnmgr/lang"
    for f in "$reporoot/lang"/*.json; do
        install -Dm644 "$f" "$pkgdir/usr/share/nspawnmgr/lang/$(basename "$f")"
    done

    # Docs
    install -Dm644 "$debdir/vendor/README.md" "$pkgdir/usr/share/doc/nspawnmgr/guacd-bundle-README.md"
    install -Dm644 "$reporoot/docs/administrator-guide.md" "$pkgdir/usr/share/doc/nspawnmgr/administrator-guide.md"
    # Translated copies - one subdirectory per language, English stays canonical at the top level.
    for lang in es fr pt ja zh; do
        install -Dm644 "$reporoot/docs/$lang/administrator-guide.md" "$pkgdir/usr/share/doc/nspawnmgr/$lang/administrator-guide.md"
    done
}
