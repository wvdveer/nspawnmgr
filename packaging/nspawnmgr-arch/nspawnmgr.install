# Arch's post_install()/post_upgrade()/pre_remove()/post_remove() hooks - the Arch-package
# equivalent of ../nspawnmgr-deb/debian/{postinst,prerm,postrm}. See those files' own comments
# for the full rationale behind each step; this file translates the same sequence into pacman's
# hook shape rather than re-deriving it.

_setup() {
    # Service account, stored password, SSH keypair, sudoers, sshd carve-out - all in the
    # shared, now-portable setup-sudo-account.sh (see that script's own comment on why it's
    # useradd-based, not Debian's adduser).
    /usr/lib/nspawnmgr/setup-sudo-account.sh

    # Shared bridge (nspawnbr0) - always overwritten, holds no admin customization, same
    # reasoning as ../nspawnmgr-deb/debian/postinst's own copy of these two files.
    cp /usr/share/nspawnmgr/70-nspawnmgr-bridge.netdev /etc/systemd/network/70-nspawnmgr-bridge.netdev
    cp /usr/share/nspawnmgr/70-nspawnmgr-bridge.network /etc/systemd/network/70-nspawnmgr-bridge.network
    # enable, not just restart - see ../nspawnmgr-deb/debian/postinst's own comment on this exact
    # point (confirmed live on Fedora: a plain restart doesn't survive a real host reboot).
    systemctl enable --now systemd-networkd \
        || echo "nspawnmgr: systemd-networkd enable/start failed - check 'systemctl status systemd-networkd'." >&2
    # `enable --now` on a systemd-networkd that's already running (e.g. any reinstall, or a host
    # that already used networkd for its primary NIC) is a no-op for the "now" part - it does NOT
    # notice the 70-nspawnmgr-bridge.netdev/.network files just copied above, so nspawnbr0 silently
    # never gets created. `networkctl reload` forces networkd to re-read every .netdev/.network
    # file without restarting the daemon or disrupting any link it's already managing - safe to
    # call unconditionally here regardless of whether the enable/start above was a fresh start or a
    # no-op against an already-running daemon. Confirmed live: without this, a fresh install on a
    # host where networkd was already active left nspawnbr0 never created at all.
    networkctl reload \
        || echo "nspawnmgr: networkctl reload failed - nspawnbr0 may not pick up its config; check 'systemctl status systemd-networkd'." >&2

    # Same up-to-10s poll for nspawnbr0 to actually come up before dnsmasq's own restart below,
    # for the same reason ../nspawnmgr-deb/debian/postinst polls: `systemctl restart` returns
    # once the restart is issued, not once the bridge address is actually live.
    bridge_ready=0
    i=1
    while [ "$i" -le 20 ]; do
        if /usr/sbin/ip -4 -o addr show nspawnbr0 2>/dev/null | grep -q '10\.100\.0\.1/24'; then
            bridge_ready=1
            break
        fi
        sleep 0.5
        i=$((i + 1))
    done
    [ "$bridge_ready" -eq 1 ] \
        || echo "nspawnmgr: nspawnbr0 didn't come up with 10.100.0.1/24 within 10s - the self-hosted machine bootstrap below may fail; check 'systemctl status systemd-networkd'." >&2

    # No firewall carve-out here, unlike the .deb's own ufw step - Arch ships no firewall
    # enabled by default, so there's nothing blocking the bridge's own DHCP server the way a
    # default-deny ufw setup can (see ../nspawnmgr-deb/debian/postinst's own comment on that). If
    # you've set up nftables/iptables/ufw-on-Arch yourself, make sure UDP/67 inbound on nspawnbr0
    # is allowed.

    # dnsmasq - same "always overwrite the fixed config, seed dns-hosts/upstream only if
    # missing" reasoning as the .deb. Two extra steps confirmed live-necessary on real
    # Arch/SteamOS, neither needed on Debian: (1) Arch's own dnsmasq package (2.91-1) ships no
    # /etc/dnsmasq.d/ directory at all (`pacman -Ql dnsmasq` lists only /etc/ and
    # /etc/dnsmasq.conf), unlike Debian/Fedora's dnsmasq packages - the bare `cp` failed with "No
    # such file or directory" without the mkdir. (2) Arch's own /etc/dnsmasq.conf ships
    # `conf-dir=/etc/dnsmasq.d` commented out by default (three commented variants at the bottom
    # of the file) - Debian's dnsmasq package apparently enables an equivalent by default, since
    # this was never an issue there. Just creating the directory and dropping a file in it isn't
    # enough on Arch; dnsmasq won't read it until conf-dir is actually active. Appending a fresh
    # line rather than trying to uncomment one of the three existing commented variants via sed -
    # simpler, and dnsmasq processes every conf-dir directive it finds rather than only the last,
    # so this is harmless even if conf-dir somehow becomes active elsewhere in the file too.
    mkdir -p /etc/dnsmasq.d
    grep -qE '^conf-dir=/etc/dnsmasq\.d' /etc/dnsmasq.conf \
        || echo 'conf-dir=/etc/dnsmasq.d,*.conf' >> /etc/dnsmasq.conf
    cp /usr/share/nspawnmgr/dnsmasq-nspawnmgr.conf /etc/dnsmasq.d/nspawnmgr.conf
    mkdir -p /etc/nspawnmgr
    [ -f /etc/nspawnmgr/dns-hosts ] || touch /etc/nspawnmgr/dns-hosts
    [ -f /etc/dnsmasq.d/nspawnmgr-upstream.conf ] || printf 'server=1.1.1.1\nserver=9.9.9.9\n' > /etc/dnsmasq.d/nspawnmgr-upstream.conf
    # Confirmed live on a genuinely fresh vanilla Arch install: pacman defers system-user creation
    # (dnsmasq's own sysusers.d declaration included) to a single post-transaction hook that runs
    # AFTER every package in the transaction is unpacked/configured - but this whole _setup()
    # function runs synchronously as nspawnmgr's OWN post_install(), which pacman runs BEFORE that
    # hook. Starting dnsmasq here without this line hits it before the "dnsmasq" user exists at
    # all ("unknown user or group: dnsmasq"), fails immediately, and burns through systemd's
    # restart limit in under a second (ending in start-limit-hit, not just a transient failure).
    # Debian's dnsmasq package never hit this: its user is created via a classic `adduser --system`
    # call inside its own postinst, which runs synchronously and immediately, not deferred.
    # systemd-sysusers (bare) processes every pending sysusers.d declaration right now - idempotent,
    # safe to call even when nothing is pending.
    systemd-sysusers
    systemctl restart dnsmasq \
        || echo "nspawnmgr: dnsmasq restart failed - check 'systemctl status dnsmasq'." >&2

    # Self-hosted app machine - bakes/clones debian-minimal and installs a JRE/Tomcat/the WARs/
    # guacd into it, same as the .deb. Deliberately stays Debian-minimal regardless of this
    # host's own distro (see docs/administrator-guide.md's Arch install section) - idempotent,
    # safe to call on every install/upgrade.
    /usr/lib/nspawnmgr/privileged/nspawnmgr-bootstrap-app-machine.sh
}

post_install() {
    _setup
}

post_upgrade() {
    # Identical to post_install - ../nspawnmgr-deb/debian/postinst doesn't distinguish fresh
    # install from upgrade either (`case "$1" in configure) ;; esac` fires for both), and every
    # step in _setup is already idempotent/always-overwrite by design.
    _setup
}

pre_remove() {
    # Deliberately does NOT stop/disable guacd or tomcat9 units on THIS host, unlike
    # ../nspawnmgr-deb/debian/prerm - under the current self-hosted architecture neither unit
    # ever exists here at all (both run entirely inside the self-hosted "nspawnmgr" machine, see
    # nspawnmgr-bootstrap-app-machine.sh), so prerm's own stop/disable calls are dead code there
    # too, just harmlessly so (systemctl against a nonexistent unit no-ops). Not carrying that
    # forward into new code.
    :
}

post_remove() {
    # Deliberately minimal, matching ../nspawnmgr-deb/debian/postrm's own default (non-purge)
    # behavior: never removes the nspawnmgr_exec account, /etc/nspawnmgr, the generated SSH
    # keypair/password, or the self-hosted machine itself - those are the only credentials your
    # containers stay reachable through. Full, deliberate cleanup (equivalent to postrm's
    # `purge` branch) is what the shared uninstall-nspawnmgr.sh script is for - run
    # `/usr/lib/nspawnmgr/uninstall-nspawnmgr.sh` by hand for that, same as documented for the
    # .deb. Arch's pacman gives no purge-vs-remove distinction at the hook level (post_remove()
    # fires the same way whether or not `-n` was passed to `pacman -R`), so staying conservative
    # by default here is the safer translation of the .deb's own posture, not a gap.
    :
}
